{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
  {{- if and (not .Draft) .File (hasPrefix .RelPermalink "/daily-qt/ntqt/") -}}
    {{- if and (not (hasPrefix .File.LogicalName "_")) (not (in .File.Path ".ai/")) -}}
      {{- $pages = $pages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- partial "search-shard.json" (dict "pages" $pages) -}}
